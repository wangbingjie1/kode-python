# Kode Configuration - Environment Variables

# ======================
# AI Model API Keys
# ======================
# Anthropic Claude API Key (required for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional, for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# ======================
# Database Configuration
# ======================
# Database URL (default: SQLite)
# For SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./kode.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/kode

# ======================
# Web Server Configuration
# ======================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend host and port
HOST=0.0.0.0
PORT=8001

# Python configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ======================
# Application Settings
# ======================
# Enable verbose logging
KODE_VERBOSE=false

# Default model
KODE_MODEL=claude-sonnet-4-5

# Max tokens for responses
KODE_MAX_TOKENS=4096

# Temperature (0.0 - 1.0)
KODE_TEMPERATURE=0.7

# ======================
# Docker Database Configuration
# ======================
# PostgreSQL (when using docker-compose --profile with-db)
POSTGRES_USER=kode
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=kode_erp

# MySQL (when using docker-compose --profile with-db)
MYSQL_USER=kode
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=kode_erp

# ======================
# AWS ECR Configuration
# ======================
# ECR repository (for deploy.sh script)
ECR_REPOSITORY=851725530027.dkr.ecr.ap-southeast-1.amazonaws.com
AWS_REGION=ap-southeast-1

# Deployment version (for deploy.sh script)
DEPLOY_VERSION=v1.0.0

# ======================
# Security & Authentication
# ======================
# Secret key for JWT tokens (required for authentication)
SECRET_KEY=your_secret_key_here_change_in_production

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# Google OAuth2 Configuration
# ======================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:8001/api/auth/google/callback
# 3. Copy Client ID and Client Secret here

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# For production, change to your domain:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
