# Kode Configuration - Environment Variables

# ======================
# AI Model API Keys
# ======================
# Anthropic Claude API Key (required for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional, for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# ======================
# Database Configuration
# ======================
# Database URL (default: SQLite)
# For SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./kode.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/kode

# ======================
# Web Server Configuration
# ======================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend host and port
HOST=0.0.0.0
PORT=8000

# ======================
# Application Settings
# ======================
# Enable verbose logging
KODE_VERBOSE=false

# Default model
KODE_MODEL=claude-sonnet-4-5

# Max tokens for responses
KODE_MAX_TOKENS=4096

# Temperature (0.0 - 1.0)
KODE_TEMPERATURE=0.7

# ======================
# Security (for future use)
# ======================
# Secret key for JWT tokens
# SECRET_KEY=your_secret_key_here

# Token expiration in minutes
# ACCESS_TOKEN_EXPIRE_MINUTES=60
