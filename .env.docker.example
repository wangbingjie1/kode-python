# Kode Docker 部署环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== AI API Keys ====================
# 必填：Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# 可选：OpenAI API Key
OPENAI_API_KEY=sk-xxxxx

# ==================== 数据库配置 ====================
# PostgreSQL 数据库密码（生产环境必须修改）
POSTGRES_PASSWORD=kode_password_change_me_in_production

# 数据库连接 URL（默认使用 Docker 内部 postgres 服务）
DATABASE_URL=postgresql+asyncpg://kode:${POSTGRES_PASSWORD}@postgres:5432/kode

# 可选：使用外部 PostgreSQL 数据库
# DATABASE_URL=postgresql+asyncpg://user:password@external-host:5432/kode

# 可选：使用 SQLite（仅开发环境）
# DATABASE_URL=sqlite+aiosqlite:///./kode.db

# ==================== Redis 配置 ====================
# Redis 密码（生产环境必须修改）
REDIS_PASSWORD=redis_password_change_me_in_production

# Redis 连接 URL
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# 可选：使用外部 Redis
# REDIS_URL=redis://:password@external-redis:6379/0

# ==================== 安全配置 ====================
# JWT 密钥（生产环境必须修改为随机字符串，至少 32 字符）
# 生成方法: openssl rand -base64 32
SECRET_KEY=change_this_secret_key_in_production_minimum_32_chars

# ==================== OAuth 配置（Google 登录） ====================
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth 回调地址（根据实际域名修改）
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
# 生产环境: https://yourdomain.com/api/auth/google/callback

# ==================== Stripe 支付配置 ====================
# Stripe Secret Key（sk_test_ 开头为测试环境，sk_live_ 为生产环境）
STRIPE_SECRET_KEY=sk_test_xxxxx

# Stripe Publishable Key
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe Webhook Secret（用于验证 Webhook 请求）
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ==================== 应用配置 ====================
# 运行环境（development/production）
ENVIRONMENT=production

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# ==================== 可选配置 ====================
# 允许的 CORS 源（逗号分隔）
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# 最大并发连接数
# MAX_CONNECTIONS=100

# Token 超时时间（秒）
# TOKEN_EXPIRE_SECONDS=3600

# ==================== 数据库只读用户（可选） ====================
# 用于报表查询的只读数据库用户密码
# READONLY_DB_PASSWORD=readonly_password_change_me
